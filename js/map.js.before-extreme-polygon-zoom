MapApp.lazyIndex = {
    country: null,
    state: null,
    district: null
};

MapApp.lazyLayers = MapApp.lazyLayers || [];


MapApp.lazyBoundaryLayer = null;

MapApp.createLazyBoundaryLayer = async function(level) {

    MapApp.lazyBoundaryLayers =
        MapApp.lazyBoundaryLayers || {};

    /*
     * Boundary layers are:
     *   - non-interactive
     *   - fill-free
     *   - never colored
     *   - kept according to zoom level
     */

    if (
        MapApp.lazyBoundaryLayers[level] &&
        MapApp.map.hasLayer(
            MapApp.lazyBoundaryLayers[level]
        )
    ) {
        return;
    }

    const data = await MapApp.loadAll(level);

    const layer = L.geoJSON(data, {

        style: function() {
            return {
                color:
                    level === "country"
                        ? "#333333"
                        : level === "state"
                            ? "#666666"
                            : "#999999",

                weight:
                    level === "country"
                        ? 1.8
                        : level === "state"
                            ? 1.2
                            : 0.65,

                opacity:
                    level === "country"
                        ? 0.9
                        : level === "state"
                            ? 0.8
                            : 0.6,

                fill: false,
                fillOpacity: 0,
                interactive: false
            };
        }

    }).addTo(MapApp.map);

    MapApp.lazyBoundaryLayers[level] = layer;
};;


MapApp.lazyLevel = null;


MapApp.getFeatureBBox = function(feature) {

    let minX = Infinity;
    let minY = Infinity;
    let maxX = -Infinity;
    let maxY = -Infinity;

    function walk(value) {

        if (
            Array.isArray(value) &&
            value.length >= 2 &&
            typeof value[0] === "number" &&
            typeof value[1] === "number"
        ) {
            minX = Math.min(minX, value[0]);
            maxX = Math.max(maxX, value[0]);
            minY = Math.min(minY, value[1]);
            maxY = Math.max(maxY, value[1]);
            return;
        }

        if (Array.isArray(value)) {
            for (const item of value) {
                walk(item);
            }
        }
    }

    walk(feature.geometry && feature.geometry.coordinates);

    return {
        minX,
        minY,
        maxX,
        maxY
    };
};


MapApp.pointInRing = function(point, ring) {

    const x = point[0];
    const y = point[1];

    let inside = false;

    for (
        let i = 0, j = ring.length - 1;
        i < ring.length;
        j = i++
    ) {

        const xi = ring[i][0];
        const yi = ring[i][1];

        const xj = ring[j][0];
        const yj = ring[j][1];

        const intersect =
            ((yi > y) !== (yj > y)) &&
            (
                x <
                (xj - xi) *
                (y - yi) /
                ((yj - yi) || Number.EPSILON) +
                xi
            );

        if (intersect) {
            inside = !inside;
        }
    }

    return inside;
};


MapApp.pointInPolygon = function(point, polygon) {

    if (!polygon || !polygon.length)
        return false;

    if (!MapApp.pointInRing(point, polygon[0]))
        return false;

    for (let i = 1; i < polygon.length; i++) {

        if (MapApp.pointInRing(point, polygon[i]))
            return false;
    }

    return true;
};


MapApp.pointInFeature = function(point, feature) {

    const geometry = feature.geometry;

    if (!geometry)
        return false;

    if (geometry.type === "Polygon") {

        return MapApp.pointInPolygon(
            point,
            geometry.coordinates
        );
    }

    if (geometry.type === "MultiPolygon") {

        for (const polygon of geometry.coordinates) {

            if (
                MapApp.pointInPolygon(
                    point,
                    polygon
                )
            ) {
                return true;
            }
        }
    }

    return false;
};


MapApp.buildLazyIndex = async function(level) {

    if (MapApp.lazyIndex[level])
        return MapApp.lazyIndex[level];

    const data =
        await MapApp.loadAll(level);

    const index = [];

    for (const feature of data.features || []) {

        index.push({
            feature: feature,
            bbox: MapApp.getFeatureBBox(feature)
        });
    }

    MapApp.lazyIndex[level] = index;

    return index;
};


MapApp.findLazyFeature = async function(
    lat,
    lng,
    level
) {

    const index =
        await MapApp.buildLazyIndex(level);

    const point = [lng, lat];

    for (const item of index) {

        const b = item.bbox;

        if (
            lng < b.minX ||
            lng > b.maxX ||
            lat < b.minY ||
            lat > b.maxY
        ) {
            continue;
        }

        if (
            MapApp.pointInFeature(
                point,
                item.feature
            )
        ) {
            return item.feature;
        }
    }

    return null;
};


MapApp.createLazyLayer = function(
    feature,
    level,
    styleOverride
) {

    MapApp.lazyLayers =
        MapApp.lazyLayers || [];

    const key =
        MapControls.getFeatureKey(
            feature,
            level
        );

    /*
     * NEVER create a second visual layer
     * for the same selected feature.
     */
    const existing =
        MapApp.lazyLayers.find(function(item) {
            return (
                item.level === level &&
                item.key === key &&
                item.layer &&
                MapApp.map.hasLayer(item.layer)
            );
        });

    if (existing) {
        return existing.layer;
    }

    const style =
        styleOverride ||
        MapLayers.styles[level];

    const layer =
        L.geoJSON(feature, {

            style: style,

            onEachFeature:
                function(feature, child) {
                    MapApp.bindHoverName(
                        feature,
                        child,
                        level
                    );
                }

        }).addTo(MapApp.map);

    layer.eachLayer(function(child) {
        child._mapSelected = true;

        if (child.getElement()) {
            child.getElement().style.cursor = "pointer";
        }
    });

    MapApp.lazyLayers.push({
        level: level,
        key: key,
        layer: layer
    });

    return layer;
};


MapApp.enableLazyClicks = function(level) {

    if (MapApp.lazyClickHandler) {

        MapApp.map.off(
            "click",
            MapApp.lazyClickHandler
        );
    }

    MapApp.lazyClickHandler =
        async function(event) {

            const feature =
                await MapApp.findLazyFeature(
                    event.latlng.lat,
                    event.latlng.lng,
                    level
                );

            if (!feature)
                return;

            const key =
                MapControls.getFeatureKey(
                    feature,
                    level
                );

            const existing =
                (MapApp.lazyLayers || []).find(
                    function(item) {
                        return (
                            item.level === level &&
                            item.key === key &&
                            item.layer &&
                            MapApp.map.hasLayer(item.layer)
                        );
                    }
                );

            /*
             * SHIFT + CLICK = REMOVE
             */
            if (
                event.originalEvent &&
                event.originalEvent.shiftKey
            ) {

                if (existing) {

                    const child =
                        existing.layer.getLayers()[0];

                    if (child) {
                        MapControls.handleClick(
                            {
                                originalEvent:
                                    event.originalEvent
                            },
                            child,
                            level
                        );
                    }

                    MapApp.map.removeLayer(
                        existing.layer
                    );

                    MapApp.lazyLayers =
                        MapApp.lazyLayers.filter(
                            function(item) {
                                return item !== existing;
                            }
                        );

                } else {

                    /*
                     * Also remove the saved state
                     * if a visual layer isn't present.
                     */
                    MapControls.removeSavedColor(
                        feature,
                        level
                    );
                }

                return;
            }

            /*
             * NORMAL CLICK:
             *
             * Already colored?
             * Do absolutely nothing.
             */
            if (existing) {
                return;
            }

            /*
             * Create exactly ONE visual layer.
             */
            const layer =
                MapApp.createLazyLayer(
                    feature,
                    level
                );

            const child =
                layer.getLayers()[0];

            if (!child)
                return;

            MapControls.handleClick(
                {
                    originalEvent:
                        event.originalEvent
                },
                child,
                level
            );
        };

    MapApp.map.on(
        "click",
        MapApp.lazyClickHandler
    );
};


MapApp.lazyLayers = MapApp.lazyLayers || [];

MapApp.addLazyFeature = function(feature, level) {

    const styles = {
        country: {
            color: "#777",
            weight: 1.6,
            fillColor: "#8bbcff",
            fillOpacity: 0.12
        },
        state: {
            color: "#777",
            weight: 1.5,
            fillColor: "#9bd6a5",
            fillOpacity: 0.12
        },
        district: {
            color: "#888",
            weight: 1.3,
            fillColor: "#ffd18a",
            fillOpacity: 0.12
        }
    };

    const key = MapControls.getFeatureKey(feature, level);

    /* Prevent duplicate selected layers from stacking opacity. */
    MapApp.lazyLayers = MapApp.lazyLayers || [];

    MapApp.lazyLayers = MapApp.lazyLayers.filter(function(item) {

        if (!item.layer) return false;

        if (
            item.level === level &&
            item.key === key
        ) {
            if (MapApp.map.hasLayer(item.layer)) {
                MapApp.map.removeLayer(item.layer);
            }

            return false;
        }

        return true;
    });

    const layer = L.geoJSON(feature, {
        style: styles[level],
        onEachFeature: function(f, l) {
            /* Hover handled by global hover system. */
        }
    }).addTo(MapApp.map);

    layer.eachLayer(function(l) {
        l._mapSelected = true;

        MapControls.rememberColor(
            l.feature,
            level,
            styles[level]
        );
    });

    MapApp.lazyLayers.push({
        level: level,
        key: key,
        layer: layer
    });

    return layer;
};

MapApp.showLazyLevel = async function(level) {

    MapApp.updateLevelSelection(level);

    MapApp.lazyBoundaryLayers =
        MapApp.lazyBoundaryLayers || {};

    /*
     * IMPORTANT:
     *
     * Clicking the SAME level button again must
     * NOT destroy the current selections.
     */
    if (MapApp.lazyLevel === level) {
        return;
    }

    /*
     * Remove only the currently displayed
     * colored selection polygons.
     *
     * Saved colors remain in localStorage.
     */
    /*
     * Keep all colored/selected Leaflet polygons
     * visible when switching Country / State / District.
     */


    /*
     * Boundary hierarchy:
     *
     * Country  → Country
     * States   → Country + States
     * District → Country + States + Districts
     */
    const required = {
        country: [
            "country"
        ],

        state: [
            "country",
            "state"
        ],

        district: [
            "country",
            "state",
            "district"
        ]
    };

    const keep =
        required[level];

    try {

        /*
         * Remove boundary levels that are
         * no longer required.
         */
        [
            "country",
            "state",
            "district"
        ].forEach(function(name) {

            if (
                !keep.includes(name) &&
                MapApp.lazyBoundaryLayers[name]
            ) {

                if (
                    MapApp.map.hasLayer(
                        MapApp.lazyBoundaryLayers[name]
                    )
                ) {

                    MapApp.map.removeLayer(
                        MapApp.lazyBoundaryLayers[name]
                    );

                }

            }

        });


        /*
         * Create missing boundary layers.
         */
        for (const name of keep) {

            await MapApp.createLazyBoundaryLayer(
                name
            );

        }


        /*
         * Restore the saved colored regions
         * for the level we're entering.
         *
         * Only saved regions become Leaflet
         * polygons. Everything else remains
         * boundary-only.
         */
        const data =
            await MapApp.loadAll(level);

        const saved =
            MapControls.loadColors();

        for (
            const feature of
            (data.features || [])
        ) {

            const key =
                MapControls.getFeatureKey(
                    feature,
                    level
                );

            if (!saved[key])
                continue;

            MapApp.createLazyLayer(
                feature,
                level,
                saved[key]
            );
        }


        /*
         * Keep boundary hierarchy visible.
         */
        if (
            MapApp.lazyBoundaryLayers.country &&
            MapApp.map.hasLayer(
                MapApp.lazyBoundaryLayers.country
            )
        ) {
            MapApp.lazyBoundaryLayers.country.bringToFront();
        }

        if (
            MapApp.lazyBoundaryLayers.state &&
            MapApp.map.hasLayer(
                MapApp.lazyBoundaryLayers.state
            )
        ) {
            MapApp.lazyBoundaryLayers.state.bringToFront();
        }

        if (
            MapApp.lazyBoundaryLayers.district &&
            MapApp.map.hasLayer(
                MapApp.lazyBoundaryLayers.district
            )
        ) {
            MapApp.lazyBoundaryLayers.district.bringToFront();
        }


        /*
         * Country boundary remains strongest.
         */
        if (
            MapApp.lazyBoundaryLayers.country &&
            MapApp.map.hasLayer(
                MapApp.lazyBoundaryLayers.country
            )
        ) {
            MapApp.lazyBoundaryLayers.country.bringToFront();
        }


        MapApp.lazyLevel = level;

        MapApp.enableLazyClicks(
            level
        );

    } catch (error) {

        console.error(
            "LAZY LEVEL LOAD ERROR:",
            error
        );

    } finally {

        MapApp.hideLoading();

    }
};


