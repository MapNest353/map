/* CUSTOM KEYBOARD MAP CONTROLS */
document.addEventListener("keydown", function (event) {

    const tag = event.target && event.target.tagName;

    // Never interfere with typing/search fields.
    if (
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT"
    ) {
        return;
    }

    const map = MapApp.map;

    if (!map) {
        return;
    }

    /*
     * ZOOM
     * + / ↑ = zoom in
     * - / ↓ = zoom out
     */
    if (
        event.key === "+" ||
        event.key === "=" ||
        event.key === "ArrowUp" ||
        event.code === "NumpadAdd"
    ) {
        event.preventDefault();
        map.zoomIn();
        return;
    }

    if (
        event.key === "-" ||
        event.key === "_" ||
        event.key === "ArrowDown" ||
        event.code === "NumpadSubtract"
    ) {
        event.preventDefault();
        map.zoomOut();
        return;
    }

});

/* =========================================================
   MAPNEST — HIERARCHICAL CLICK ZOOM
   Country  -> surrounding continent / area
   State    -> containing country
   District -> containing state

   This is deliberately separate from the coloring system.
   ========================================================= */

(function () {

    if (MapApp.parentZoomClickHandler)
        return;

    MapApp.parentZoomClickHandler = async function (event) {

        /* Shift-click keeps its existing remove behavior. */
        if (
            event.originalEvent &&
            event.originalEvent.shiftKey
        ) {
            return;
        }

        const level = MapApp.lazyLevel;

        if (
            level !== "country" &&
            level !== "state" &&
            level !== "district"
        ) {
            return;
        }

        try {

            const lat = event.latlng.lat;
            const lng = event.latlng.lng;

            /*
             * Find exactly what was clicked using the
             * existing lazy spatial index.
             */
            const clickedFeature =
                await MapApp.findLazyFeature(
                    lat,
                    lng,
                    level
                );

            if (!clickedFeature)
                return;

            let targetFeature = null;

            /*
             * COUNTRY:
             *
             * There is no higher administrative parent,
             * so zoom to the surrounding geographic area.
             */
            if (level === "country") {

                targetFeature = clickedFeature;

            }

            /*
             * STATE:
             *
             * Find the country containing the exact
             * click point.
             */
            else if (level === "state") {

                targetFeature =
                    await MapApp.findLazyFeature(
                        lat,
                        lng,
                        "country"
                    );

            }

            /*
             * DISTRICT:
             *
             * Find the state containing the exact
             * click point.
             */
            else if (level === "district") {

                targetFeature =
                    await MapApp.findLazyFeature(
                        lat,
                        lng,
                        "state"
                    );

            }

            if (!targetFeature)
                return;

            /*
             * Convert the parent feature's geometry into
             * Leaflet bounds without creating a permanent
             * visual layer.
             */
            const temporaryLayer =
                L.geoJSON(targetFeature);

            const bounds =
                temporaryLayer.getBounds();

            if (!bounds.isValid())
                return;

            /*
             * Country click:
             * show the surrounding continent / region,
             * rather than zooming tightly onto the country.
             */
            if (level === "country") {

                MapApp.map.fitBounds(
                    bounds,
                    {
                        padding: [70, 70],
                        maxZoom: 4,
                        animate: true,
                        duration: 0.7
                    }
                );

                return;
            }

            /*
             * State click:
             * fit the containing country.
             */
            if (level === "state") {

                MapApp.map.fitBounds(
                    bounds,
                    {
                        padding: [70, 70],
                        maxZoom: 6,
                        animate: true,
                        duration: 0.7
                    }
                );

                return;
            }

            /*
             * District click:
             * fit the containing state.
             */
            if (level === "district") {

                MapApp.map.fitBounds(
                    bounds,
                    {
                        padding: [70, 70],
                        maxZoom: 8,
                        animate: true,
                        duration: 0.7
                    }
                );

            }

        } catch (error) {

            console.warn(
                "Hierarchical click zoom failed:",
                error
            );

        }

    };

    /*
     * This is intentionally attached directly to the map,
     * independently of MapControls.handleClick().
     *
     * Therefore:
     * - coloring remains untouched
     * - already-colored regions still zoom
     * - lazy clicking remains untouched
     */
    MapApp.map.on(
        "click",
        MapApp.parentZoomClickHandler
    );

    console.log(
        "✓ Hierarchical click zoom enabled"
    );

})();

/* =========================================================
   ZOOM-BASED BOUNDARY WEIGHTS
   Clean hierarchy at world view, progressively stronger
   when zooming in.
   ========================================================= */
(function () {

    if (window.__MapNestZoomBoundaryWeights) return;
    window.__MapNestZoomBoundaryWeights = true;

    function updateBoundaryWeights() {

        if (!window.MapApp || !MapApp.map) return;

        const zoom = MapApp.map.getZoom();
        const layers =
            MapApp.lazyBoundaryLayers || {};

        /*
         * COUNTRY
         *
         * World: 1.00
         * Medium: 1.25
         * Close:  1.60
         */
        if (layers.country) {
            layers.country.setStyle({
                weight:
                    zoom <= 4
                        ? 1.0
                        : zoom <= 6
                            ? 1.25
                            : 1.6,

                opacity:
                    zoom <= 4
                        ? 0.72
                        : zoom <= 6
                            ? 0.82
                            : 0.9
            });
        }

        /*
         * STATE
         *
         * World: 0.30
         * Medium: 0.55
         * Close:  1.00
         */
        if (layers.state) {
            layers.state.setStyle({
                weight:
                    zoom <= 4
                        ? 0.30
                        : zoom <= 6
                            ? 0.55
                            : 1.0,

                opacity:
                    zoom <= 4
                        ? 0.50
                        : zoom <= 6
                            ? 0.65
                            : 0.78
            });
        }

        /*
         * DISTRICT
         *
         * World: 0.12
         * Medium: 0.25
         * Close:  0.50
         */
        if (layers.district) {
            layers.district.setStyle({
                weight:
                    zoom <= 4
                        ? 0.12
                        : zoom <= 6
                            ? 0.25
                            : 0.50,

                opacity:
                    zoom <= 4
                        ? 0.35
                        : zoom <= 6
                            ? 0.48
                            : 0.58
            });
        }
    }

    MapApp.map.whenReady(function () {

        MapApp.map.on(
            "zoomend",
            updateBoundaryWeights
        );

        updateBoundaryWeights();
    });

    const originalShowLazyLevel =
        MapApp.showLazyLevel;

    if (
        typeof originalShowLazyLevel === "function"
    ) {
        MapApp.showLazyLevel =
            async function () {

                const result =
                    await originalShowLazyLevel.apply(
                        MapApp,
                        arguments
                    );

                updateBoundaryWeights();

                return result;
            };
    }

})();


/* =========================================================
   MAPNEST INITIAL BOUNDARY WEIGHT FIX
   Apply zoom-dependent weights immediately when lazy
   boundary layers are created, not only after zooming.
   ========================================================= */
(function () {

    if (window.__MapNestInitialBoundaryWeightFix) return;
    window.__MapNestInitialBoundaryWeightFix = true;

    function applyBoundaryWeights() {

        if (!window.MapApp || !MapApp.map) return;

        const zoom = MapApp.map.getZoom();
        const layers =
            MapApp.lazyBoundaryLayers || {};

        /*
         * COUNTRY
         */
        if (layers.country) {
            layers.country.setStyle({
                weight:
                    zoom <= 4
                        ? 1.0
                        : zoom <= 6
                            ? 1.25
                            : 1.6,

                opacity:
                    zoom <= 4
                        ? 0.72
                        : zoom <= 6
                            ? 0.82
                            : 0.9
            });
        }

        /*
         * STATE
         */
        if (layers.state) {
            layers.state.setStyle({
                weight:
                    zoom <= 4
                        ? 0.30
                        : zoom <= 6
                            ? 0.55
                            : 1.0,

                opacity:
                    zoom <= 4
                        ? 0.50
                        : zoom <= 6
                            ? 0.65
                            : 0.78
            });
        }

        /*
         * DISTRICT
         */
        if (layers.district) {
            layers.district.setStyle({
                weight:
                    zoom <= 4
                        ? 0.12
                        : zoom <= 6
                            ? 0.25
                            : 0.50,

                opacity:
                    zoom <= 4
                        ? 0.35
                        : zoom <= 6
                            ? 0.48
                            : 0.58
            });
        }
    }

    /*
     * Make the function available to the map system.
     */
    MapApp.updateBoundaryWeights =
        applyBoundaryWeights;

    /*
     * Apply whenever the user zooms.
     */
    if (MapApp.map) {
        MapApp.map.on(
            "zoomend",
            applyBoundaryWeights
        );
    }

    /*
     * IMPORTANT:
     * Boundary layers are created asynchronously.
     * Wrap createLazyBoundaryLayer so the correct
     * thickness is applied immediately after creation.
     */
    const originalCreate =
        MapApp.createLazyBoundaryLayer;

    if (
        typeof originalCreate === "function"
    ) {

        MapApp.createLazyBoundaryLayer =
            async function(level) {

                const result =
                    await originalCreate.apply(
                        MapApp,
                        arguments
                    );

                applyBoundaryWeights();

                return result;
            };
    }

    /*
     * Also keep checking briefly during initial startup
     * so layers created during the first render receive
     * the correct world-view thickness immediately.
     */
    let attempts = 0;

    const startupTimer =
        setInterval(function() {

            applyBoundaryWeights();

            attempts++;

            if (attempts >= 30) {
                clearInterval(startupTimer);
            }

        }, 100);

})();

